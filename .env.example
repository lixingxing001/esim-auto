# 215.im 临时邮箱服务 API Key。配置后会优先使用该邮箱服务。
YYDS_MAIL_API_KEY=

# 可选。Superalink 注册默认姓名。
SUPERALINK_FIRST_NAME=
SUPERALINK_LAST_NAME=

# 可选。浏览器代理地址，例如 http://127.0.0.1:7890
SUPERALINK_PROXY_URL=

# 可选。自建 checkout Web 服务监听配置。
SUPERALINK_CHECKOUT_HOST=127.0.0.1
SUPERALINK_CHECKOUT_PORT=53333

# 可选。自建 checkout 默认参数。
SUPERALINK_AFFILIATE_CODE=FRONT0000
SUPERALINK_COUPON=FRONT0000
SUPERALINK_DEFAULT_COUNTRY=CN
SUPERALINK_DEFAULT_CURRENCY=THB
SUPERALINK_DEFAULT_QUANTITY=1

# 可选。PayPal Buttons 的公开 client id。留空时使用当前 Superalink 前端公开配置。
SUPERALINK_PAYPAL_CLIENT_ID=

# 可选。支付后等待 eSIM 邮件的分钟数。
SUPERALINK_MAIL_WAIT_MIN=10
